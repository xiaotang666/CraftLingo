{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftLingo",
  "version": "0.0.2",
  "identifier": "com.xiaotang01.craftlingo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "方块译匠 · CraftLingo",
        "width": 1365,
        "height": 768,
        "minWidth": 1100,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ghfast.top/https://github.com/xiaotang666/CraftLingo/releases/latest/download/update.json",
        "https://gh-proxy.com/https://github.com/xiaotang666/CraftLingo/releases/latest/download/update.json",
        "https://ghproxy.net/https://github.com/xiaotang666/CraftLingo/releases/latest/download/update.json",
        "https://gh-proxy.net/https://github.com/xiaotang666/CraftLingo/releases/latest/download/update.json",
        "https://github.com/xiaotang666/CraftLingo/releases/latest/download/update.json"
      ],
